# Base URL of the backend Go API. In dev Next proxies /api to this target.
# In production this should be the public API origin (e.g. https://api.example.com).
NEXT_PUBLIC_API_URL=/api

# Telegram Login Widget bot username (without @). Leave empty to hide the button.
NEXT_PUBLIC_TELEGRAM_BOT=

# Used by next.config rewrites for local dev proxy.
API_BASE_URL=http://localhost:8080
